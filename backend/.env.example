# 백엔드 환경변수 예시. backend/.env로 복사해 쓴다(.env는 커밋 금지).
# DB. 로컬은 SQLite, 배포는 Supabase PostgreSQL URL
DATABASE_URL=sqlite:///./dev.db
# 위치 ID 서명 키. 배포 필수, 긴 임의 문자열
SECRET_KEY=change-me-to-a-long-random-string
# 쿠키 Secure. 로컬 http에서만 0, 배포는 1(기본값)
COOKIE_SECURE=0
# 카카오 없이 개발 로그인. 로컬 전용(배포 금지)
DEV_LOGIN=1
# 가상 축제·장소 데이터. 로컬 전용(배포 금지)
SEED_DEMO=1
# 장소·비용 시연용 추정 데이터. 실제 운영은 0
SIMULATION_DATA=0
# 배포 프런트 주소. 아이디 로그인 Origin 검증에 사용
FRONTEND_ORIGIN=http://localhost:3000
# Gemini 추천 키(Google AI Studio)
GEMINI_API_KEY=
# 선택. 생략하면 gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
# ODsay 서버용 키. 대중교통 예상 경로
ODSAY_API_KEY=
# 카카오 로그인 + 위치 검색
KAKAO_REST_API_KEY=
# 카카오모빌리티 자동차 길찾기
KAKAO_MOBILITY_REST_API_KEY=
# 카카오 앱에서 Client Secret을 켰을 때만
KAKAO_CLIENT_SECRET=
# 카카오 앱에 같은 주소 등록
KAKAO_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback/kakao
# 선택. 한글 TTF/TTC 글꼴 경로. 생략하면 backend/fonts/NanumGothic-Regular.ttf
EXPORT_FONT_PATH=
# 정리 작업(/api/v1/ops/cleanup) 인증. Vercel Cron이 Bearer로 보낸다. 비우면 엔드포인트 404
CRON_SECRET=
# VERCEL=1은 Vercel이 자동으로 넣는다(생성·내보내기 동기 실행). 직접 설정하지 않는다.
